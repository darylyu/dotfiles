# dunst notifications, used by i3. Colors are gruvbox dark, to match i3_config.
# Written for dunst 1.9 (Debian 12). See `man dunst`.

[global]
    follow = mouse
    origin = top-right
    # Below the bar, lined up with the i3 gaps
    offset = 12x42
    width = 360
    height = 160
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 6
    separator_color = frame

    font = FiraMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    ellipsize = end

    icon_position = left
    max_icon_size = 48

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#d65d0e"
    timeout = 8

[urgency_critical]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#cc241d"
    timeout = 0

# Volume and brightness pop-ups from i3_osd.sh
[osd]
    appname = osd
    timeout = 2
    foreground = "#ebdbb2"
    frame_color = "#504945"
    highlight = "#d65d0e"
    icon_position = off
