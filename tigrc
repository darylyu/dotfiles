set main-view = \
    id \
    date:custom,format="%b %d %H:%M %z" \
    author:full,width=12 \
    commit-title:yes,graph,refs,overflow=no

# Light text on a dark background, using the terminal background as the text color.
color cursor		green	default	reverse bold
color title-blur	blue	default	reverse
color title-focus	blue	default	reverse bold
